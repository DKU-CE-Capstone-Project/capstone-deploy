# Public HTTPS; certificates are renewed automatically in the caddy_data volume.
econmind.duckdns.org {
	encode zstd gzip

	# This exact, read-only endpoint uses its own backend bearer authentication.
	# Preserve Authorization here; never forward team Basic credentials to it.
	handle /internal/admin/status {
		reverse_proxy econmind-api:8000
	}

	handle {
		basic_auth {
			{$ECONMIND_TEAM_USER} {$ECONMIND_TEAM_PASSWORD_HASH}
		}
		reverse_proxy frontend:80 {
			header_up -Authorization
			# Use the direct peer only; discard any client-supplied forwarding chain.
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}
}

# Existing IP bookmarks redirect to the canonical HTTPS URL.
http://35.216.13.110 {
	redir https://econmind.duckdns.org{uri} permanent
}
