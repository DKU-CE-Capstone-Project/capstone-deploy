# 홈 서버 /etc/econmind/mongo-tunnel.env 로 복사해 채운다. (root:root, 0600)
# 실제 값은 Git, Notion, 채팅에 쓰지 않는다.
# CHANGEME 항목은 절차서 2절의 기록표에서 옮겨 적는다. 추측해서 채우지 않는다.
# systemd 환경 파일이므로 따옴표와 행 끝 주석을 쓰지 않는다.

# GCP VM SSH 접속 정보. 현재 수동 터널 명령에서 확인한다.
GCP_SSH_USER=CHANGEME_GCP_SSH_USER
GCP_SSH_HOST=CHANGEME_GCP_SSH_HOST
GCP_SSH_PORT=CHANGEME_GCP_SSH_PORT

# -R 앞부분: GCP VM에서 리스너가 열리는 주소와 포트.
# 컨테이너가 host.docker.internal 로 닿을 수 있는 주소여야 한다.
TUNNEL_REMOTE_BIND=CHANGEME_GCP_LISTEN_ADDRESS
TUNNEL_REMOTE_PORT=CHANGEME_GCP_LISTEN_PORT

# -R 뒷부분: 홈 서버에서 본 MongoDB 주소와 포트.
TUNNEL_LOCAL_HOST=CHANGEME_HOME_MONGO_ADDRESS
TUNNEL_LOCAL_PORT=CHANGEME_HOME_MONGO_PORT

# 터널 전용 키와 GCP 호스트 키 파일. /var/lib/econmind-tunnel 아래 절대 경로로 쓴다.
TUNNEL_IDENTITY_FILE=CHANGEME_ABSOLUTE_PATH_TO_PRIVATE_KEY
TUNNEL_KNOWN_HOSTS=CHANGEME_ABSOLUTE_PATH_TO_KNOWN_HOSTS
