                        "minLength": 1
                      },
                      "name": {
                        "bsonType": "string",
                        "minLength": 1
                      },
                      "config_hash": {
                        "bsonType": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  },
                  "prompt_version": {
                    "bsonType": "string",
                    "minLength": 1
                  },
                  "preprocessing_version": {
                    "bsonType": "string",
                    "minLength": 1
                  },
                  "rag_version": {
                    "bsonType": "string",
                    "minLength": 1
                  },
                  "input_budget_version": {
                    "bsonType": "string",
                    "minLength": 1
                  }
                }
              },
              "created_at": {
                "bsonType": "date"
              },
              "updated_at": {
                "bsonType": "date"
              }
