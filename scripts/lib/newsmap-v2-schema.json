            "bsonType": "int",
            "enum": [
              2
            ]
          },
          "body_id": {
            "bsonType": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "news_id": {
            "bsonType": "string",
            "minLength": 1
          },
          "source_url": {
            "bsonType": "string",
            "minLength": 1
          },
          "content": {
            "bsonType": "string",
            "minLength": 1
          },
          "content_hash": {
            "bsonType": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
