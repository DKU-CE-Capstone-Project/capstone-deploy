                        "title": {
                          "bsonType": "string"
                        }
                      }
                    }
                  },
                  "risk_factors": {
                    "bsonType": "array",
                    "items": {
                      "bsonType": "string"
                    }
                  },
                  "created_at": {
                    "bsonType": [
                      "date",
                      "string"
                    ]
                  },
                  "schema_version": {
                    "bsonType": "int",
                    "enum": [
                      1
                    ]
                  },
                  "updated_at": {
                    "bsonType": [
                      "date",
                      "string"
                    ]
                  },
                  "owner_sid": {
                    "bsonType": "string",
                    "minLength": 1
                  },
                  "rag_sources": {
                    "bsonType": "array",
                    "items": {
                      "bsonType": "string"
                    }
                  },
                  "verification": {
                    "bsonType": [
                      "object",
                      "null"
                    ]
                  }
                }
              }
            }
          ]
        }
