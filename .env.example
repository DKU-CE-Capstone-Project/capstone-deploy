# capstone-deploy 환경변수 — 값 없이 키만 커밋한다.
#   cp .env.example .env  후 값을 채운다. .env 는 .gitignore 에 있다.
#   ⚠ 실제 값은 Git이나 프로젝트 문서에 적지 않는다.
#     폐기한 옛 Atlas 자격증명은 절대 재사용하지 않는다.

# ── MongoDB 계정 ────────────────────────────────────────────────────────────
# root: 운영/점검용. 앱에는 주지 않는다.
MONGODB_ROOT_USERNAME=
MONGODB_ROOT_PASSWORD=

# app: econmind-api 가 쓰는 계정. capstone_news 에만 readWrite 권한이 붙는다.
# ⚠ 비밀번호는 URL 안전 문자만 쓸 것 (@ : / ? # 금지) — MONGODB_URI 에 그대로 들어간다.
#   생성 예: openssl rand -base64 24 | tr -d '/+=' | head -c 32
MONGODB_APP_USERNAME=
MONGODB_APP_PASSWORD=

# ── MongoDB 설정 ────────────────────────────────────────────────────────────
MONGODB_DB_NAME=capstone_news
USE_MONGODB=true
# WiredTiger 캐시 상한(MB). 8GB 서버 기준 1024 가 적정.
MONGODB_WT_CACHE_MB=1024

# ── AI 에이전트 ─────────────────────────────────────────────────────────────
USE_RAG=true
EMBEDDING_MODEL=gemini-embedding-001

# ── 외부 API 키 (서버 Compose는 필수 키 누락 시 기동하지 않음) ─────────────
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEWSAPI_KEY=

# ── 실제 서버(compose.server.yaml) ────────────────────────────────────────
# 서버의 기존 앱 계정 URI를 유지. 로컬 PC의 127.0.0.1 URI를 복사하지 않는다.
# 컨테이너 DB 예: mongodb://<app>:<password>@mongodb:27017/capstone_news?authSource=admin
# 기존 SSH 터널 예: mongodb://<app>:<password>@host.docker.internal:27017/capstone_news?authSource=admin&directConnection=true
MONGODB_URI=
APP_ORIGIN=https://econmind.duckdns.org
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DIFFBOT_TOKEN=
USE_CRITIC=true

# 뉴스맵 전용 벡터: 리포트 RAG(EMBEDDING_MODEL, 768d)와 별도 저장.
# 가중치·임계값은 실뉴스 품질 검증 전 초기값. 후보 상한과 표시 limit은 별개.
# Decision API is opt-in; API keys are never frontend build arguments.
NEWS_MAP_CLIENT_HOURLY_LIMIT=30
NEWS_MAP_GLOBAL_HOURLY_LIMIT=300
NEWS_MAP_SELECTOR=embedding
NEWS_MAP_DECISION_TIMEOUT_SECONDS=30
NEWS_MAP_DECISION_TOTAL_TIMEOUT_SECONDS=90
NEWS_MAP_DECISION_CONCURRENCY=4
NEWS_MAP_DECISION_MAX_CALLS=200
NEWS_MAP_DECISION_CACHE_TTL_SECONDS=3600
NEWS_MAP_EMBEDDING_MODEL=gemini-embedding-001
NEWS_MAP_EMBEDDING_DIMENSIONS=768
NEWS_MAP_EMBEDDING_TASK_TYPE=SEMANTIC_SIMILARITY
# 요청당 평가하는 고유 주변 후보(중심 제외, 같은 ID·URL 중복 제외).
# 최초 라운드는 원래 검색 순서의 INITIAL개, 부족할 때만 총 MAX개까지 확장.
NEWS_MAP_INITIAL_CANDIDATES=20
NEWS_MAP_MAX_CANDIDATES=50
NEWS_MAP_EMBEDDING_CONCURRENCY=3
NEWS_MAP_MIN_RELEVANCE=0.65
NEWS_MAP_KEYWORD_WEIGHT=0.10
NEWS_MAP_ENTITY_ONLY_PENALTY=0.10
# 반복 정보 제외는 대상·방향·수치·시점·제목/설명 근거를 함께 요구. 코사인만으로 제외하지 않음.
NEWS_MAP_MMR_LAMBDA=0.70
NEWS_MAP_REPEAT_COSINE=0.92
NEWS_MAP_REPEAT_TEXT_SIMILARITY=0.55
NEWS_MAP_REPEAT_TITLE_SIMILARITY=0.50
NEWS_MAP_REPEAT_SHORT_TEXT_SIMILARITY=0.85
NEWS_MAP_REPEAT_MAX_HOURS=48
NEWS_MAP_REPEAT_DESCRIPTION_MIN_CHARS=40
NEWS_MAP_REPEAT_NOVELTY_RATIO=0.25
# 확장: 남은 저장 후보 → 원래 검색어 다음 원시 위치 → 제목·설명 근거 검색어.
# 외부 검색 단계 수·검색당 요청 건수·확장 전체 시간에 각각 상한. 0이면 외부 검색 비활성화.
NEWS_MAP_SUPPLEMENT_MAX_SEARCHES=3
NEWS_MAP_SUPPLEMENT_PAGE_SIZE=20
NEWS_MAP_SUPPLEMENT_TIMEOUT_SECONDS=20
NEWS_MAP_SUPPLEMENT_CACHE_TTL_SECONDS=60
