# docker-compose 용 환경변수 템플릿.
#
#   cp .env.example .env   후 값을 채운다.
#   .env는 .gitignore에 있으며 절대 커밋하지 않는다.
#
# ⚠️ 이전 MongoDB Atlas 자격증명(Notion "데이터베이스 정보" 페이지에 평문으로 남아 있는 값)은
#    재사용하지 말 것. 아래 값은 새로 생성한다. 예:
#      openssl rand -base64 24

# ── MongoDB (자체 호스팅) ─────────────────────────────────────────────────────
# root: 운영/점검용. 백엔드는 이 계정을 쓰지 않는다.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# 앱 전용 계정 — capstone_news DB에 readWrite 권한만 갖는다.
# mongo-init/00-app-user.js가 최초 기동 시 이 값으로 계정을 만든다.
MONGO_APP_USERNAME=econmind_app
MONGO_APP_PASSWORD=

MONGO_DB_NAME=capstone_news

# ── mongo-express (웹 DB 뷰어, --profile tools 로만 기동) ────────────────────
# 화면 로그인용. DB 비밀번호와 다른 값을 쓴다.
MONGOEXPRESS_USERNAME=admin
MONGOEXPRESS_PASSWORD=
# 세션/쿠키 서명키 — 아무 랜덤 문자열이면 된다 (openssl rand -hex 32)
MONGOEXPRESS_COOKIE_SECRET=
MONGOEXPRESS_SESSION_SECRET=

# ── LLM / 외부 API (선택) ─────────────────────────────────────────────────────
# 비워 두면 LLM 요약·리포트는 graceful fallback으로 동작하고,
# 임베딩이 없으므로 RAG 벡터검색도 자동으로 꺼진다 (서비스는 계속 뜬다).
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
